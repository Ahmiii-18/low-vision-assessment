<%- include('partials/head', { title: 'Assessment Complete' }) %>
<div class="page-center wide">
  <div class="card">
    <h1>✅ Assessment Complete</h1>
    <p class="sub">Participant <%= participant.participant_id %> · <%= responses.length %> tasks recorded</p>

    <% if (scoredTotal > 0) { %>
      <div class="score"><strong>Score:</strong> <%= score %> / <%= scoredTotal %> scored correctly</div>
    <% } %>

    <table class="table">
      <thead>
        <tr><th>#</th><th>Task</th><th>Response</th><th>Result</th><th>Time</th></tr>
      </thead>
      <tbody>
        <% responses.forEach(r => { %>
          <tr>
            <td><%= r.task_number %></td>
            <td><%= r.task_name %></td>
            <td><%= r.response || '—' %></td>
            <td>
              <% if (r.skipped) { %><span class="skip">Skipped</span>
              <% } else if (r.correct === null) { %>—
              <% } else if (r.correct) { %><span class="ok">Correct</span>
              <% } else { %><span class="no">Incorrect</span><% } %>
            </td>
            <td><%= r.duration_ms ? (r.duration_ms / 1000).toFixed(1) + 's' : '—' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="actions">
      <a href="/export/excel/participant/<%= participant.id %>" class="btn green">📗 Excel</a>
      <a href="/export/participant/<%= participant.id %>" class="btn primary">📄 CSV</a>
      <a href="/data" class="btn secondary">📊 View All Data</a>
      <a href="/" class="btn secondary">New Participant</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>